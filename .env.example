# ==============================================================================
# Mafqoodi Platform - Environment Configuration Template
# ==============================================================================

# --- Global Environment ---
ENVIRONMENT=development
PROJECT_NAME="Mafqoodi Platform"

# --- PostgreSQL Database ---
POSTGRES_USER=mafqoodi_user
POSTGRES_PASSWORD=mafqoodi_secret_password_change_in_prod
POSTGRES_DB=mafqoodi_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://mafqoodi_user:mafqoodi_secret_password_change_in_prod@postgres:5432/mafqoodi_db

# --- Storage Settings ---
STORAGE_BACKEND=local
UPLOAD_DIR=/app/uploads

# --- Backend Application (FastAPI) ---
BACKEND_PORT=8000
SECRET_KEY=change_this_to_a_random_secure_hex_secret_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# --- Frontend Application (Next.js) ---
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
